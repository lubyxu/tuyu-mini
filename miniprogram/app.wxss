/**app.wxss**/
@import './component.wxss';

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
} 

button {
  background: initial;
}

button:focus{
  outline: 0;
}

button::after{
  border: none;
}


page {
  background: #f6f6f6;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.flex {
  display: flex;
}
.flex-wrap {
  flex-wrap: wrap;
}

.items-center {
  align-items: center;
}

.justify-center {
  justify-content: center;
}

.gap-8 {
  gap: 8px;
}
.relative {
  position: relative;
}
.absolute {
  position: absolute;
}
.overflow-hidden {
  overflow: hidden;
}
.w-full {
  width: 100%;
}
.h-full {
  height: 100%;
}

.t-0 {
  top: 0;
}
.b-0 {
  bottom: 0;
}
.l-0 {
  left: 0;
}
.r-0 {
  right: 0;
}
.text-strong {
  font-weight: 500;
}
.text-error-color {
  color: #F14B3F;
}
.text-success-color {
  color: rgba(76, 173, 95, 1);
}

.text-gray-color {
  color: rgba(0, 0, 0, 0.65);
}

.text-strong {
  font-weight: 500;
}

.text-14 {
  font-size: 14px;
}
.text-13 {
  font-size: 13px;
}
.text-12 {
  font-size: 12px;
}

.mt-4 {
  margin-top: 4px;
}
.ml-4 {
  margin-left: 4px;
}
.mr-4 {
  margin-right: 4px;
}
.mt-8 {
  margin-top: 8px;
}
.mb-16 {
  margin-bottom: 16px;
}

.rounded-8 {
  border-radius: 8px;
}