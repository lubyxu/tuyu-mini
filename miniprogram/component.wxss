.fuyu-half-screen-dialog {
	max-height: 92vh;
}

.fuyu-half-screen-dialog .weui-half-screen-dialog__bd {
	min-height: 48px;
	padding-bottom: 40px !important;
}

.fuyu-half-screen-dialog .weui-half-screen-dialog__title {
	font-weight: 500;
	font-size: 16px;
}

.fuyu-half-screen-dialog .weui-half-screen-dialog__hd .weui-half-screen-dialog__hd__side {
	position: initial;
}

.fuyu-half-screen-dialog .weui-half-screen-dialog__hd .weui-half-screen-dialog__hd__side .weui-icon-btn {
	position: absolute;
	right: 20px;
	top: 22px;
	background: rgba(0, 0, 34, 0.06);
	height: 24px;
	width: 24px;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
}

.fuyu-half-screen-dialog .weui-half-screen-dialog__hd .weui-half-screen-dialog__hd__side .weui-icon-btn .weui-icon-close-thin {
	height: 16px;
	width: 16px;
	color: rgba(0, 0, 34, 0.5);
}


.fuyu-half-screen-dialog .weui-half-screen-dialog__ft  {
	padding: 0;
}