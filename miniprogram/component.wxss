.fuyu-half-screen-dialog {
  max-height: 92vh;
  z-index: 99999;
}

.fuyu-half-screen-dialog .weui-half-screen-dialog__bd {
	min-height: 48px;
	padding-bottom: 40px !important;
}

.fuyu-half-screen-dialog .weui-half-screen-dialog__title {
	font-weight: 500;
	font-size: 16px;
}

.fuyu-half-screen-dialog .weui-half-screen-dialog__hd .weui-half-screen-dialog__hd__side {
  display: none;
}

.fuyu-half-screen-dialog .weui-half-screen-dialog__hd .weui-half-screen-dialog__hd__side .weui-icon-btn {
	position: absolute;
	right: 20px;
	top: 22px;
	background: rgba(0, 0, 34, 0.06);
	height: 24px;
	width: 24px;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
}

.fuyu-half-screen-dialog .weui-half-screen-dialog__hd .weui-half-screen-dialog__hd__side .weui-icon-btn .weui-icon-close-thin {
	height: 16px;
	width: 16px;
	color: rgba(0, 0, 34, 0.5);
}


.fuyu-half-screen-dialog .weui-half-screen-dialog__ft  {
	padding: 0;
}

.fuyu-half-screen-dialog .title-container {
  position: relative;
  font-size: 16px;
  line-height: 28px;
  font-weight: 500;
  color: rgba(0, 0, 34, 0.91);
  text-align: center;
  width: 100%;
}

.fuyu-half-screen-dialog .title-container .title {
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}
.fuyu-half-screen-dialog .title-container .close {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: rgba(0, 0, 34, 0.06);
  position: absolute;
  right: -40px;
  top: -2px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fuyu-half-screen-dialog .title-container .close .icon-close {
  display: flex;
  align-items: center;
  justify-content: center;
}
