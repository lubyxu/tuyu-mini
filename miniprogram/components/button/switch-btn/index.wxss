.switch-btn {
	border-radius: 24px;
	overflow: hidden;
	height: 20px;
	padding: 0 6px;
	font-size: 8px;
	color: #603B0C;
	background-color: #00002214;
	padding-right: 8px;
}

.switch-btn .pin {
	background: #fff;
	width: 16px;
	height: 16px;
	border-radius: 50%;
	position: absolute;
	top: 2px;
	left: 2px;
  box-shadow: 0px 1px 3px 0px #0000000D;
  
  transition: all 0.2s;
}

.switch-btn.switch-btn-unchecked .spin-text {
	padding-left: 16px;
	padding-top: 4px;
}

.switch-btn.switch-btn-checked .spin-text {
  padding-left: 2px;
  padding-right: 16px;
	padding-top: 4px;
}
.switch-btn.switch-btn-checked .pin {
  left: calc(100% - 14px);
}