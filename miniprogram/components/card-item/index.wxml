<cover-view
    class="card-item"
    bind:tap="onScenicClcik"
>
    <cover-image class="background-image" src="{{background}}" mode="widthFix"></cover-image>
    <cover-view class="preview-box">
        <button wx:if="{{!isLogined}}" open-type="getPhoneNumber" bindgetphonenumber="onRegisterAccount" hover-class="none">
            <cover-image src="{{preview}}" class="preview" />
        </button>
        <cover-image wx:else src="{{preview}}" class="preview" bind:tap="onProductClick" />
    </cover-view>
    <cover-view >
        <cover-view wx-if="{{showProducts}}" class="product-list">
            <cover-view 
                wx:for="{{_products}}"
                class="product-box {{item.id === selectId && 'product-box-selected'}}"
                data-id="{{item.id}}"
                bind:tap="onSelect"
            >
                <cover-image
                    wx:key="{{item.id}}"
                    class="product-item"
                    src="{{item.preview}}"
                />
            </cover-view>
        </cover-view>
        <cover-view class="desc-box" style="color:{{light ? '#ffbd8f': '#77270d'}}">
            <cover-view class="desc-title">{{title}}</cover-view>
            <cover-view class="desc-subtitle">
                {{subtitle}}
                <cover-view wx-if="{{tags.length > 0}}">
                    <cover-view 
                        wx:for="{{tags}}"
                        class="product-tag"
                    >
                        {{item}}
                    </cover-view>
                </cover-view>
            </cover-view>
        </cover-view>
    </cover-view>
    <cover-image wx-if="{{isVisited}}" src="../../images/visited.svg" class="visited-icon" />
</cover-view>