
<cover-view class="{{ title ?  'nav-bar-with-title' : 'nav-bar'}} {{className}}" style="height:{{navBarHeight}}px;">
    <cover-view
        wx-if="{{title}}"
        class="title-bar-title"
        style="line-height:{{menuHeight}}px;bottom:{{menuBotton}}px;">
            {{title}}
    </cover-view>

    <cover-view
        wx:elif="{{sampleReturn}}"
        class="return-title"
        style="line-height:{{menuHeight}}px;left:16px;bottom:{{menuBotton}}px;"
        bind:tap="navigateBack"
    >
        <cover-image
            class="return-small-icon"
            src="https://fuyuoss.oss-cn-shanghai.aliyuncs.com/front-end/return.png"
        />
        <cover-view wx-if="{{returnTitle}}" class="return-title-text">{{returnTitle}}</cover-view>
    </cover-view>
    <cover-image
        wx:elif="{{showHome}}"
        class="home-icon"
        src="../../images/icons/home.png"
        style="line-height:{{menuHeight}}px;left:16px;bottom:{{menuBotton}}px;"
        bind:tap="navigateToHome"
    />
    <cover-image
        wx:elif="{{showBack}}"
        class="return-big-icon"
        src="https://fuyuoss.oss-cn-shanghai.aliyuncs.com/front-end/return-icon.png"
        style="line-height:{{menuHeight}}px;left:16px;bottom:{{menuBotton}}px;"
        bind:tap="navigateBack"
    />
</cover-view>

