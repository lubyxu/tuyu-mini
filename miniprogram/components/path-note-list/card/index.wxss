/* components/path-note-list/card/index.wxss */
.card {
	padding: 20px;
	border-radius: 24px;
	border: 1px solid rgba(0, 0, 0, 0.08);
	height: 170px;
	overflow: hidden;
  box-shadow: 0 4px 4px 0 rgba(0, 0, 0, 0.04);
  position: relative;
  margin-bottom: 12px;
  background: #fff;
}

.title,
.container,
.progress {
  position: relative;
  z-index: 2;
}
.title {
	font-size: 18px;
	color: #000;
  line-height: 26px;
}

.container {
	font-size: 12px;
	padding: 2px 0;
	color: rgba(0, 0, 0, 0.65);
	height: 108px;
}

.divider {
	background: rgba(0, 0, 0, 0.12);
	width: 1px;
	margin-top: 1px;
	margin-bottom: 1px;
	margin-left: 8px;
	margin-right: 8px;
}

.number {
	margin-right: 2px;
}

.info {
	margin-top: 8px;
	border-left: 2px solid rgba(0, 0, 0, 0.12);
	border-radius: 1px;
	padding-left: 8px;

	font-size: 12px;
	line-height: 26px;
}

.info-item {
	display: flex;
	align-items: center;
}

.info-item image {
	width: 14px;
	height: 14px;
	margin-right: 4px;
}

.right-bottom-image {
	position: absolute;
	bottom: 0;
	right: 20px;
	width: 154px;
	height: 115px;
	transform: rotate(-15deg);
	z-index: 0;
}

.right-bottom-image image {
	position: absolute;
	width: 154px;
	height: 115px;
}

.right-bottom-image image:nth-child(1) {
	transform: translateX(-10px) translateY(16px);
	opacity: 0.35;
}

.right-bottom-image image:nth-child(2) {
	transform: translateX(-20px) translateY(32px);
	opacity: 0.05;
}

.progress {
	margin-top: 10px;
}

.progress-bar {
	height: 12px;
	width: 103px;
	border: 1px solid #000;
}