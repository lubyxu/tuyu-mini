<!--components/path-note-list/progress-bar/index.wxml-->
<view class="container {{isDone ? 'done' : 'pending'}} {{progress === 0 ? 'starting' : ''}}">
  <view style="width: {{progress === 0 ? 14 : progress * 120}}px;" class="progress">
	  <image
		  wx:if="{{!isDone}}"
		  class="pin"
		  src="https://oss-whale-peach.meetwhale.com/wos%2Fharbor%2F2Lwvd5pe_ihUJxN2WdrNk%2FGroup%201312316268.svg"
		/>
		<view class="striped w-full"></view>
	</view>
	<view wx:if="{{!isDone}}" class="text-undone text">
	  <text wx:if="{{progress === 0}}">立即开启</text>
		<text wx:else>{{done}}/{{total}}</text>
	</view>
	<view wx:else class="text-done text">
	  已打卡
	</view>
</view>
