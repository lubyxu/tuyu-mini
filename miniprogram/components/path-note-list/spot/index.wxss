/* components/path-note-list/spot/index.wxss */
.title {
	display: flex;
	justify-content: space-between;
}

.title .name {
	font-size: 16px;
	font-weight: 600;
}

.tag {
	border: 0.5px solid rgba(241, 75, 63, 0.25);
	height: 18px;
	line-height: 18px;
	font-size: 12px;
	border-radius: 4px;
	display: inline-flex;
	align-items: center;
	padding: 0 3px;
	color: rgba(241, 75, 63, 1);
}

.tag-hot-filled {
	color: #fff;
	font-weight: 500;
	background: linear-gradient(270deg, #F30240 0%, rgba(243, 2, 64, 0.7) 100%);
}

.right {
	flex: 1;
}