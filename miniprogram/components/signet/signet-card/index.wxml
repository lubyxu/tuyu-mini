<view class="signet-card flex items-center justify-center {{isBook ? 'signet-book' : ''}} {{bordered ? 'signet-bordered' : ''}}">
  <image src="{{showImg || fallbackImg}}" mode="{{mode}}" style="{{mode === 'heightFix' ? 'height: 76px; max-width: 76px;' : 'width: 62px; max-height: 100px;'}}" />
</view>