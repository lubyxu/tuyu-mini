.signet-card {
  width: 74px;
  height: 106px;
  overflow: hidden;
  background-color: #fff;
}
.signet-bordered {
  border: 0.5px solid #0000001F;
}
.signet-card image {
  width: 64px;
}

.signet-card.signet-book {
  background-color: #FBE9BF;
  border-radius: 4px;
}

.signet-card:not(.signet-book) image {
  width: 62px;
  height: 70px;
}