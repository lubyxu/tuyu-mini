<view class="signet-container">
  <image src="{{bgImage}}" mode="widthFix" />

  <view class="signet-container-content">
    <view class="signet-container-empty" wx:if="{{!signetSrc}}">
      <view>
        <empty
          empty="https://oss-whale-peach.meetwhale.com/wos%2Fharbor%2F7Kayw0D5pI5rCt4QaR2aP%2Fimage.svg"
          height="135"
          width="135"
          text="暂无印章"
        />
      </view>

      <view class="empty-btn-groups">
        <view class="btn" bind:tap="onUpload">本地上传</view>
        <view class="btn" bind:tap="onScan">扫一扫</view>
      </view>
    </view>

    <view wx:else>
      <image src="{{signetSrc}}" style="width: 200px;" mode="widthFix" />
    </view>
  </view>
</view>
