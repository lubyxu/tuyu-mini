.page {
  width: 100%;
  height: 100%;
  background-color: #f2f3f7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.store-list {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 32rpx;
  width: 100%;
}

.store-item {
  margin-bottom: 20rpx;
  padding: 16px 16px 8px;
  width: 100%;
  background: #FFFFFF;
  border-radius: 16px;
  box-sizing: border-box;
}