page {
	background: #F0EBDD;
}

.root {
	padding: 16px;
}

.book-card {
	border-radius: 4px;
	border: 0.5px solid #0000001F;
	overflow: hidden;
	width: 107px;
	height: 150px;
	position: relative;
}

.page-footer {
	position: fixed;
	left: 0;
	bottom: 0;
  right: 0;
  z-index: 11;
	background-color: #F0EBDD;

	display: flex;
	gap: 16px;

	padding: 10px 16px 42px;
}
