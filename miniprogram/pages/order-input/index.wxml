<view class="root">

	<view>
    <view class="form-item" wx:if="{{!editable}}">
      <view class="form-label">订单号</view>
			<view class="form-input-content">
			  {{shopping_code || '--'}}
			</view>
    </view>
		<view class="form-item">
			<view class="form-label">姓名</view>
			<view class="form-input-content">
				<input wx:if="{{editable}}" value="{{name}}" class="form-input" placeholder="请填写姓名" bindchange="onNameChange" />
        <view wx:else>{{name}}</view>
			</view>
		</view>
		<view class="form-item">
			<view class="form-label">电话</view>
			<view class="form-input-content">
				<input class="form-input" wx:if="{{editable}}" value="{{phone}}" placeholder="请填写电话" type="digit" bindchange="onPhoneChange" />
        <view wx:else>{{phone}}</view>
			</view>
		</view>
		<view class="form-item">
			<view class="form-label">地址</view>
			<view class="form-input-content">
				<input class="form-input" value="{{address}}" wx:if="{{editable}}" placeholder="请填写地址" bindchange="onAddressChange" />
        <view wx:else>{{address}}</view>
			</view>
		</view>
	</view>

	<view class="page-footer" wx:if="{{editable}}">
		<view class="w-full">
			<chinese-button unit="%" width="100" className="btn-confirm" bind:tap="onConfirm">
				<text style="font-size: 20px; line-height: 28px;">确认</text>
			</chinese-button>
		</view>
	</view>

</view>