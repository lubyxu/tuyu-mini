/**index.wxss**/

.page {
  width: 100vw;
  height: 100vh;
  background-color: #fbeddb;
  display: flex;
  flex-direction: column;
}

.top {
  padding: 0 24rpx;
}

.title {
  padding-top: 196rpx;
  display: flex;
  align-items: center;
}

.title-icon {
  width: 28rpx;
  height: 28rpx;
}

.title-text {
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 400;
  font-size: 12px;
  line-height: 17px;
  color: rgba(0, 0, 0, 0.65);
}

.subtitle {
  margin-top: 8rpx;
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 500;
  font-size: 32px;
  line-height: 45px;
  color: #000000;
}

.order-content {
  flex: 1;
  box-sizing: border-box;
  width: 100%;
  margin-top: 20rpx;
  background: #fff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 36rpx 32rpx;
}

.order-tips {
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 500;
  font-size: 12px;
  line-height: 17px;
  color: #999999;
}

.order-title {
  margin-top: 26rpx;
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 500;
  font-size: 16px;
  line-height: 22px;

  color: #000000;
}

.date-container {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.date-item {
  width: calc(25% - 10px);
  height: 68px;
  background: #FFFFFF;
  border: 0.5px solid #FFB800;
  border-radius: 6px;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  outline: none; 
}

.date-item-active {
  background: #FFE6C6;
  box-shadow: 0 0 0 2px #FFB800;
  position: relative;
}

.date-item-select-icon {
  width: 38rpx;
  height: 38rpx;
  position: absolute;
  bottom: -2rpx;
  right: -2rpx;
} 

.date-item-title {
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 600;
  font-size: 14px;
  line-height: 20px;
  color: #624E26;
}

.date-item-date {
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 400;
  font-size: 13px;
  line-height: 18px;
  text-align: center;
  
  color: #624E26;
}

.date-item-disable {
  background: #f2f1ef;
  border: 0;
}

.date-item-title-disable {
  color: #999999
}

.date-item-date-disable {
  color: #999999
}

.date-container {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.time-item {
  width: calc(50% - 10px);
  height: 68px;
  background: #FFFFFF;
  border: 0.5px solid #FFB800;
  border-radius: 6px;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  outline: none; 
}

.btn-box {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: fixed;
  bottom: 64rpx;
}

.order-success-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.success-icon {
  margin-top: 104rpx;
  width: 62rpx;
  height: 62rpx;
}

.success-text {
  margin-top: 10rpx;
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 600;
  font-size: 24px;
  line-height: 34px;
  /* identical to box height */
  text-align: center;

  color: #624E26;
}

.success-time {
  margin-top: 10rpx;
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 500;
  font-size: 19px;
  line-height: 27px;
  /* identical to box height */
  text-align: center;

  color: #999999;
}

.success-number-box {
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  width: 257px;
  height: 211px;
  background: #F4F4F4;
  border-radius: 6px;
}

.success-number-no {
  margin-top: 52rpx;
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 600;
  font-size: 88px;
  line-height: 123px;
  text-align: center;

  color: #624E26;
}

.success-number-text {
  margin-top: 26rpx;
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 400;
  font-size: 19px;
  line-height: 27px;
  /* identical to box height */
  text-align: center;

  color: #999999;
}

.order-cancle-btn {
  width: 640rpx;
  height: 128rpx;
}