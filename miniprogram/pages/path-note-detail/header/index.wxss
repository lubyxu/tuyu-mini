/* pages/path-note-detail/header/index.wxss */
.header {
	box-sizing: border-box;
  /* padding-top: 100px; */
	position: relative;
	height: 100%;
	width: 100vw;
	overflow: hidden;
}

.bg-image {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
}
.bg-image image {
	width: 100%;
	height: 100%;
	z-index: 0;
}

/* .title {
	font-size: 32px;
  font-weight: 500;
	min-height: 51px;
} */

.sub-title {
	position: absolute;
	left: 0;
	right: 0;
	width: 100%;
	bottom: 36rpx;
	padding: 0 24rpx;
}

.image {
	height: 50px;
	width: 90px;
	border-radius: 8px;
	border: 2px solid #fff;
}

.progress-bar-pin {
  position: absolute;
  right: 12px;
}