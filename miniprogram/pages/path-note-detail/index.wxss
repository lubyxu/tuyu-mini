/* pages/path-note-detail/index.wxss */
page {
}

.map-container {
	height: 160px;
	padding: 0;
	border: 0.5px solid rgba(0, 0, 0, 0.12);
	border-radius: 14px;
  overflow: hidden;
  position: relative;
}

.btn-see-map {
  position: absolute;
  right: 8px;
  bottom: 4px;
  padding: 8px 16px;
  background: #fff;
  color: rgba(0, 0, 0, 0.65);
  font-size: 12px;
  box-shadow: 0px 4px 4px 0px rgba(0, 0, 0, 0.08);
  border-radius: 24px;
  display: flex;
  align-items: center;
  gap: 4px;
}

.btn-add-to-plan {
	font-size: 24px;
	font-weight: 500;
	color: rgba(255, 189, 143, 1);
}

.footer {
	padding-top: 14px;
	box-shadow: 1px 0px 4px 0px rgba(0, 0, 0, 0.12);
}

.footer {
	transition: all 0.5s;
	position: fixed;
	bottom: 0;
	left: 0;
	right: 0;
	background-color: #ffffff;
}

.footer.moving {
	opacity: 0;
	bottom: -50px;
	
}
.footer.done {
	position: relative;
	background-color: transparent;
}

.user-path-header {
  position: relative;
}
.btn-share {
  background: linear-gradient(270deg, #FF309F 0%, #FF6669 91.84%);
  background-clip: text;
  -webkit-background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
  font-size: 14px;
  font-weight: 400;
  position: absolute;
  margin: 0;
  padding: 0;
  right: 0;
  top: 0;
  display: inline-flex;
  align-items: center;
  width: auto !important;
  gap: 2px;
}