.protral {
  width: 100vw;
  height: 100vh;
  background-color: #fbeddb;
  overflow-x: hidden;
}

.user-content-subtitle {
  display: flex;
  align-items: center;
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 400;
  font-size: 12px;
  line-height: 17px;
  color: rgba(0, 0, 34, 0.91);
}

.money-icon {
  width: 40rpx;
  height: 40rpx;
}

.current-box {
  margin: 0 8rpx;
}

.current-count {
  font-size: 16px;
}

.path-title-box {
  width: 100%;
  height: 64rpx;
  display: flex;
  justify-content: center;
}

.path-title-img {
  width: 430rpx;
  height: 40rpx;
}

.details-list {
  padding: 40rpx 32rpx;
  padding-bottom: 244rpx;
}

.details-box {
  position: relative;
  width: 100%;
  /* height: 484rpx; */
  background: #FFFFFF;
  border-radius: 16px;
  display: flex;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-bottom: 32rpx;
}

.visited-icon {
  width: 64rpx;
  height: 64rpx;
  position: absolute;
  left: 32rpx;
  top: -6rpx;
}

.product-icon {
  width: 100%;
  height: auto;
  border-top-left-radius: 16px;
  border-top-right-radius: 16px;
}

.complete-icon {
  position:absolute;
  right: 0;
  top: 0;
  width: 240rpx;
  height: 240rpx;
}

.product-desc-box {

  /* margin-top: 20rpx; */
  padding: 24rpx 30rpx;
  width: 100%;
  border-top: 1px solid #E5E5E5;
  box-shadow: inset 0px 0.5px 1px rgba(0, 0, 34, 0.1);
  border-radius: 0px 0px 16px 16px;
  box-sizing: border-box;
}

.produc-desc-status-box {
  display: flex;
  align-items: center;
  justify-content: center;
}

.produc-desc-title {
  display: flex;
}

.product-name {
  flex-grow: 1;
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 600;
  font-size: 16px;
  line-height: 22px;
  color: rgba(0, 0, 0, 0.95);
}

.status-text {
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 500;
  font-size: 12px;
  line-height: 14px;
  color: #34C759;
}

.status-text-not-complete {
  color: black;
}

.btn-box {
  display: flex;
  align-items: center;
  justify-content: center;
  position: fixed;
  bottom: 0;
  width: 100%;
  height: 204rpx;
  filter: drop-shadow(1px 0px 4px rgba(0, 0, 0, 0.12));
}