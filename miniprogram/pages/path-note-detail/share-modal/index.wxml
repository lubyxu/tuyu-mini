<!--pages/path-note-detail/privilege-modal/index.wxml-->
<half-screen-dialog
	show="{{show}}"
	title=""
	ext-class="fuyu-half-screen-dialog"
	bindclose="onClose"
  closabled="{{false}}"
>
  <view class="title-container" slot="title">
    <view class="title">分享</view>
    <view
      class="close"
      bind:tap="onClose"
    >
      <mp-icon
        icon="close"
        color="rgba(0, 0, 34, 0.5)"
        size="{{16}}"
        class="icon-close"
      />
    </view>
  </view>
	<view style="text-align: center;" slot="desc">
		<view class="content">
		  <view class="content-item">
        <button open-type="share" class="btn-modal-share">
          <image src="https://oss-whale-peach.meetwhale.com/wos%2Fharbor%2FbRkLf2hst-njH-bjOZ2hQ%2F%E5%BE%AE%E4%BF%A1.svg" class="wx-icon" />
          <view class="share-text">分享给好友</view>
        </button>
      </view>
      <view class="content-item">
        <button open-type="share" class="btn-modal-share">
          <image src="https://wos.stage.meetwhale.com/CIWiN5G6skSTh1EueFIV2" class="wx-icon" />
          <view class="share-text">分享到朋友圈</view>
        </button>
      </view>
		</view>
	</view>
</half-screen-dialog>