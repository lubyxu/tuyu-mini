  background-size: 100vw 100vh;
}

.photo-upload-box {
  box-sizing: border-box;
  position: absolute;
  width: 80vw;
  right: 10vw;
  top: 130.04px;
  background: #FEFEFE;
  border-radius: 18.4273px;
  padding: 20rpx;
  transform: rotate(-5.68deg);
}

