<scroll-view scroll-x="{{true}}">
  <view class="flex items-center gap-8" style="padding: 12px 16px 24px;">
	  <view wx:for="{{books}}" style="height: 106px; width: 74px;">
		  <image src="{{item.show_image}}" class="w-full h-full" mode="aspectFill" />
		</view>
	</view>
</scroll-view>

<view class="mt-20">
	<section-title title="{{curBook.BookInfo.name}}" fontSize="15" />

	<view class="signet-container">
		<view class="signet-container-item">
			<image src="{{curBookConfig.page_bg_img}}" class="w-full h-full" mode="aspectFill" />
			<view class="footer flex items-center justify-center">封面</view>
		</view>

		<view class="signet-container-item" wx:for="{{curCards}}" data-index="{{index}}" bind:tap="onCardSelect">
			<radio color="#CE3219" checked="{{curIndex == index}}" style="transform: scale(0.9)"/>
			<image src="{{item.img}}" class="w-full h-full" mode="aspectFill" />
		</view>
	</view>
</view>

<view class="page-footer">
  <view style="width: 100%">
		<chinese-btn unit="%" width="100">取消</chinese-btn>
	</view>
	<view style="width: 100%">
		<chinese-btn unit="%" width="100">确认</chinese-btn>
	</view>
</view>