page {
   background-color: #F0EBDD;
   padding-bottom: 40px;
}
.signet-title {
  font-size: 24px;
  font-weight: 500;
  height: 24px;
  color: #000022D9;
  justify-content: space-around;
}

.signet-title-input {
  display: inline-block;
  width: fit-content;
  min-width: 0;
}

.signet-add-footer {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 12px;

  position: fixed;
  bottom: 41px;
  left: 0;
  right: 0;
  font-size: 20px;
}

.banner-right .nick-name {
  font-size: 18px;
  font-weight: 500;
}

.banner-right .desc {
  font-size: 12px;
}